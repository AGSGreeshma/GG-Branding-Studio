# Copy to .env.local and fill in. Never commit real values.
# Keep this file in sync with plan.md §20.3.

# OpenAI
OPENAI_API_KEY=
# Strongest model within budget: generation and synthesis (plan §20.2)
MODEL_PRIMARY=
# Small/mini model: critics, interviewer turns, consistency checks
MODEL_FAST=
# Set to 1 if the chosen models reject the temperature parameter (reasoning models drop it)
OPENAI_OMIT_TEMPERATURE=0
# Reasoning effort per tier: none | low | medium. Only affects reasoning models
# (o-series, gpt-5 and later); the gpt-4.1 family ignores it. Leave empty to send nothing.
MODEL_PRIMARY_REASONING_EFFORT=low
MODEL_FAST_REASONING_EFFORT=low
# Ask reasoning models for a summary of their thinking: off | auto | detailed.
# Off by default: the summary costs output tokens and nothing in the app reads it.
OPENAI_REASONING_SUMMARY=off

# Postgres (Neon). Use the pooled connection string.
DATABASE_URL=

# Signs the guest cookie gg_uid. Generate with: openssl rand -base64 32
SESSION_SECRET=

NEXT_PUBLIC_APP_URL=http://localhost:3000
DEMO_MODE=0
RATE_LIMIT_PER_MIN=20
DAILY_AI_CALLS_PER_PROJECT=200
